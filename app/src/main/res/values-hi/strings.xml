    <string name="mod_ct">सीटी स्कैन</string>
    <string name="mod_ct_short">एक्स-रे से अनुप्रस्थ चित्र</string>
    <string name="mod_ct_long">सीटी स्कैनर एक्स-रे से शरीर के पतले अनुप्रस्थ चित्र बनाता है। ग्रे मान हाउंसफ़ील्ड इकाइयाँ (HU) हैं: हवा −1000, पानी 0 और हड्डी कुछ सौ से 1000 से ऊपर। इसीलिए इस ऐप के Window/Level प्रीसेट HU में काम करते हैं।</string>
    <string name="mod_mr">एमआरआई</string>
    <string name="mod_mr_short">चुंबकीय क्षेत्र, बहुत विस्तार</string>
    <string name="mod_mr_long">एमआरआई एक्स-रे के बिना तेज़ चुंबकीय क्षेत्र और रेडियो तरंगों का उपयोग करता है। यह मस्तिष्क, मांसपेशियों और जोड़ों जैसे कोमल ऊतकों को बहुत विस्तार से दिखाता है। इसके ग्रे मानों का सीटी जैसा तय पैमाना नहीं होता।</string>
    <string name="mod_xa">एंजियोग्राफ़ी</string>
    <string name="mod_xa_short">रक्त वाहिकाएँ, फ़िल्म के रूप में</string>
    <string name="mod_xa_long">एंजियोग्राफ़ी में एक्स-रे चित्र लेते समय कंट्रास्ट द्रव से रक्त वाहिकाएँ दिखाई जाती हैं, अक्सर एक छोटी फ़िल्म (सिने) के रूप में। इस ऐप के नमूना स्कैन हृदय की कोरोनरी धमनियों के हैं।</string>
    <string name="mod_us">अल्ट्रासाउंड</string>
    <string name="mod_us_short">ध्वनि तरंगें, कोई विकिरण नहीं</string>
    <string name="mod_us_long">अल्ट्रासाउंड बिना विकिरण के ध्वनि तरंगों से चित्र बनाता है। चित्र लाइव होता है; DICOM फ़ाइल में अलग-अलग चित्र या छोटी क्लिप होती हैं।</string>
    <string name="mod_cr">एक्स-रे</string>
    <string name="mod_cr_short">एक प्रक्षेपण चित्र</string>
    <string name="mod_cr_long">सामान्य एक्स-रे (CR या DX) एक ही प्रक्षेपण चित्र होता है, जैसे हड्डियों या फेफड़ों का। जो कुछ विकिरण को रोकता है, जैसे हड्डी, वह हल्का दिखता है।</string>
    <string name="mod_mg">मैमोग्राफ़ी</string>
    <string name="mod_mg_short">स्तन का एक्स-रे</string>
    <string name="mod_mg_long">मैमोग्राफ़ी कम विकिरण खुराक वाला स्तन का एक्स-रे है। चित्र बड़े और बहुत विस्तृत होते हैं।</string>
